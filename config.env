CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/Mayuri-Chan/android_kernel_xiaomi_ruby
KERNEL_SOURCE_BRANCH=twrp-12
KERNEL_CONFIG=ruby_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld

# Clang - используем прямую ссылку через кастомный Clang
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/7959a85e31cff14baafc78f09c7182bf26448223/clang-r487747b.tar.gz
CUSTOM_CLANG_BRANCH=main
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# GCC
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# KernelSU
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5
APPLY_KSU_PATCH=true

# Configuration
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
REMOVE_UNUSED_PACKAGES=true

# AnyKernel3
USE_CUSTOM_ANYKERNEL3=false

# Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# Build boot images
BUILD_BOOT_IMG=false
